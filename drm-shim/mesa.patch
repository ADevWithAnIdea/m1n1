+/* Preserve the open-file description when a dup atomically replaces a fd. */
+static int
+finish_fd_replacement(int fd, struct shim_fd *source)
+{
+   if (fd < 0)
+      return fd;
+   drm_shim_fd_unregister(fd);
+   if (source) {
+      int ret = drm_shim_fd_register(fd, source);
+      if (ret) {
+         real_close(fd);
+         errno = -ret;
+         return -1;
+      }
+   }
+   return fd;
+}
+
+PUBLIC int
+dup2(int oldfd, int newfd)
+{
+   get_function_pointers();
+   if (oldfd == newfd)
+      return real_dup2(oldfd, newfd);
+   struct shim_fd *source = drm_shim_fd_lookup(oldfd);
+   return finish_fd_replacement(real_dup2(oldfd, newfd), source);
+}
+
+#ifdef __linux__
+PUBLIC int
+dup3(int oldfd, int newfd, int flags)
+{
+   get_function_pointers();
+   struct shim_fd *source = drm_shim_fd_lookup(oldfd);
+   return finish_fd_replacement(real_dup3(oldfd, newfd, flags), source);
+}
+#endif
